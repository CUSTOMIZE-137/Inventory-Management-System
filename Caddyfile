# Caddyfile for Inventory Management System (AWS EC2 deployment)
#
# Replace `inventory.example.com` with your domain or subdomain pointing to the
# EC2 instance's public IP. Caddy automatically provisions HTTPS via Let's Encrypt,
# which is required for PWA service workers and camera-based barcode scanning.
#
# Upstream FastAPI backend runs on port 8001 (avoiding port 8000, which is used
# by another system sharing this EC2 instance).
#
# Example backend startup command:
#   uvicorn app.main:app --host 127.0.0.1 --port 8001 --proxy-headers --forwarded-allow-ips="127.0.0.1"

inventory.example.com {
	# Path to the built Vite frontend bundle (`cd frontend && npm run build`)
	root * /var/www/inventory-management-system/frontend/dist

	encode zstd gzip

	# Baseline browser security headers matching the FastAPI backend middleware
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Block hidden dotfiles (except ACME challenges) and JS source maps
	@blocked {
		path_regexp (?i)(^|/)\.|\.map$
		not path /.well-known/*
	}
	handle @blocked {
		respond 404
	}

	# Reverse-proxy API and health endpoints to FastAPI on port 8001
	# (Add /docs /redoc /openapi.json here if you want OpenAPI docs exposed)
	@backend path /api /api/* /health /ready
	handle @backend {
		reverse_proxy 127.0.0.1:8001 {
			header_up X-Real-IP {remote_host}
		}
	}

	# Prevent caching of PWA service worker and manifest so updates roll out promptly
	@pwa_files path /sw.js /registerSW.js /manifest.webmanifest
	handle @pwa_files {
		header Cache-Control "no-cache, no-store, must-revalidate"
		header /manifest.webmanifest Content-Type "application/manifest+json"
		file_server
	}

	# Long-lived immutable cache for content-hashed Vite build assets
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Static files & SPA fallback (deep client-side routes load index.html)
	handle {
		route {
			try_files {path} /index.html
			header /index.html Cache-Control "no-cache, no-store, must-revalidate"
			file_server
		}
	}

	log {
		output file /var/log/caddy/inventory.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
